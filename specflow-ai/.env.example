# =============================================================================
# SpecFlow AI — конфигурация. Скопируйте в .env и заполните.
#   Windows:  copy .env.example .env
# Файл .env не коммитится (см. .gitignore).
# =============================================================================

# --- Anthropic API -------------------------------------------------------------
# Ключ: platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Свой шлюз/прокси (обычно не нужно)
# ANTHROPIC_BASE_URL=

# Модели агентов. По ТЗ — семейство 4.6.
# Рекомендация: claude-opus-5-5 дешевле Opus 4.6 ($4/$20 против $5/$25 за 1 млн
# токенов) и читает изображения до 2576 px (у 4.6 — 1568 px): мелкий текст
# чертежей читается надёжнее, а тайлов на лист в 4 раза меньше.
# claude-sonnet-5-5 ($2/$10) дешевле Sonnet 4.6 ($3/$15).
MODEL_EXTRACTOR=claude-opus-4-6
MODEL_VALIDATOR=claude-opus-4-6
MODEL_MATCHER=claude-sonnet-4-6
MODEL_ESTIMATOR=claude-sonnet-4-6

# Глубина рассуждений: low | medium | high | xhigh | max
EFFORT_EXTRACTOR=high
EFFORT_VALIDATOR=high
EFFORT_MATCHER=medium
EFFORT_ESTIMATOR=medium

LLM_MAX_OUTPUT_TOKENS=32000
LLM_TIMEOUT_S=600
# Повторы при 429/5xx/обрыве связи (экспоненциальная задержка с джиттером)
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY_S=2
LLM_RETRY_MAX_DELAY_S=60
# Одновременных запросов к API (страницы/пакеты обрабатываются параллельно)
LLM_MAX_CONCURRENCY=4
# Сколько тайлов чертежа отправлять в одном запросе Агента 1
VISION_TILES_PER_REQUEST=12
# Прогон останавливается, если стоимость превысит лимит (USD)
RUN_BUDGET_USD=20

# --- Обработка PDF -------------------------------------------------------------
# 300 DPI — по ТЗ. 200 DPI снижает стоимость Vision примерно в 2,2 раза;
# проверьте на своих чертежах, читается ли мелкий шрифт.
PDF_RENDER_DPI=300
# Перекрытие тайлов в пикселях (180 px при 300 DPI ≈ 15 мм)
PDF_TILE_OVERLAP_PX=180
# rgb | gray (gray легче, но теряется цвет проводников и пометок)
PDF_COLORSPACE=rgb
# Сохранять полный лист в 300 DPI для просмотра в UI
PDF_SAVE_FULL_PAGE=true
# Выше этого размера полный лист сохраняется с пониженным DPI (тайлы — всегда 300)
PDF_FULL_PAGE_MAX_MEGAPIXELS=80
PDF_EXTRACT_TABLES=true
# На очень «тяжёлых» листах поиск таблиц пропускается (долго и бесполезно)
PDF_TABLE_MAX_VECTOR_PATHS=60000
# Защита от случайной отправки 300-страничного альбома
PDF_MAX_PAGES=60
# 0 — один поток (надёжно, рекомендуется со Streamlit); N — N процессов
PDF_WORKERS=0
PDF_JPEG_QUALITY=90

# --- Хранилище и каталог ----------------------------------------------------------
DATA_DIR=./data
# По умолчанию: DATA_DIR/catalog.db и DATA_DIR/chroma
# CATALOG_DB_PATH=./data/catalog.db
# CHROMA_DIR=./data/chroma
# Мультиязычная модель эмбеддингов (RU/EN/HE); скачивается при первом запуске
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MATCH_TOP_K=3
MATCH_MIN_CONFIDENCE=0.6

# --- Коммерческий расчёт по умолчанию (меняется в UI) -------------------------------
# Валюта КП (ISO 4217): ILS, USD, EUR, RUB …
BASE_CURRENCY=ILS
DEFAULT_MATERIAL_MARKUP_PCT=25
# Ставка нормо-часа сборки в BASE_CURRENCY — укажите свою
DEFAULT_LABOR_RATE_PER_HOUR=180
DEFAULT_CONTINGENCY_PCT=5
# НДС: Израиль — 18%. Для другой страны укажите действующую ставку.
DEFAULT_VAT_PCT=18
CONTRACTOR_NAME=

# --- Приложение -----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
